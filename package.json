{
  "name": "vexo-field-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:ui && wrangler dev --port 8787",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build": "vite build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit src fixtures",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/e2e/demo.mjs",
    "db:migrate:local": "wrangler d1 migrations apply vexo-field-assistant --local",
    "db:migrate:remote": "wrangler d1 migrations apply vexo-field-assistant --remote --env production",
    "db:seed:local": "node scripts/seed/seed-local.mjs",
    "smoke:platform": "bash scripts/platform/smoke.sh",
    "deploy": "npm run typecheck && npm run build && wrangler deploy --env production"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7",
    "wrangler": "^4.86.0"
  }
}
